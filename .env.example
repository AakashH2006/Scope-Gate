# VendorGate configuration (section 11 of README.md).
# Copy to .env for local work. For a deployment, set real environment variables
# instead -- a file in the repository is not where secrets belong.
#
# Generate the two keys with:  python -m vendorgate.cli keys

# --- identity --------------------------------------------------------------
# The URL vendors are given. Must be https:// for anything but a local run;
# the gateway refuses to start otherwise.
PUBLIC_URL=http://127.0.0.1:8000

# Signs session cookies and keys the token / device hashes.
# Changing it invalidates every live session and every unused link.
SECRET_KEY=

# Encrypts admin TOTP secrets at rest. Losing it means re-enrolling the admin.
TOTP_ENC_KEY=

# --- database --------------------------------------------------------------
# Local development:
DATABASE_URL=sqlite+aiosqlite:///./vendorgate.db
# AWS RDS:
# DATABASE_URL=postgresql+asyncpg://vendorgate:PASSWORD@db-host:5432/vendorgate

# --- the internal site ------------------------------------------------------
# Pluggable: the demo points this at the mock site, a client points it at their
# own. It must not be reachable from the internet except through the gateway.
UPSTREAM_URL=http://127.0.0.1:9000

# Pages an admin may grant, as path prefixes. A prefix covers the page and
# anything below it. Nothing outside this list can be granted.
ALLOWED_PAGES=/dashboard/overview,/dashboard/reports,/dashboard/tickets

# Read-only by default (section 6.6). Widen only when a target site needs it.
ALLOWED_METHODS=GET,HEAD

# --- clocks ----------------------------------------------------------------
LINK_TTL_MINUTES=180          # link validity before the first sign-in
MAX_ACCESS_MINUTES=480        # ceiling on what an admin may choose
EXPIRY_TICK_SECONDS=2         # how often the expiry job sweeps

# --- limits ----------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5          # failures before a grant is locked
LOGIN_RATE_PER_MINUTE=10      # vendor sign-in attempts per client address
ADMIN_RATE_PER_MINUTE=10      # admin sign-in attempts per client address
ADMIN_IDLE_TIMEOUT_MINUTES=20
MAX_REQUEST_BYTES=1048576
UPSTREAM_TIMEOUT_SECONDS=20

# --- logging ---------------------------------------------------------------
LOG_DASHBOARD_DAYS=7
LOG_RETENTION_DAYS=365

# --- email (section 9) -----------------------------------------------------
# file    writes the message to MAIL_OUTBOX_DIR as .eml -- demo without a server
# console prints it
# smtp    real delivery
MAIL_BACKEND=file
MAIL_OUTBOX_DIR=outbox

# Gmail with an app password, for the demo:
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=the-16-character-app-password
# MAIL_FROM=you@gmail.com

# Amazon SES later -- a configuration change, no code change:
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com

# --- runtime ---------------------------------------------------------------
# Keep cookies Secure unless you are deliberately running plain HTTP locally.
# SECURE_COOKIES=true
# Only true when a trusted proxy (Caddy) really sets X-Forwarded-For.
TRUST_FORWARDED_FOR=true
# Where uvicorn binds. Behind Caddy this stays on loopback.
BIND_HOST=127.0.0.1
BIND_PORT=8000
